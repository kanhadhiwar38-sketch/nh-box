<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF3A52"
                android:endColor="#C0001D"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8001A"
                android:endColor="#9B0015"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#44FF1A38" />
        </shape>
    </item>
</selector>
