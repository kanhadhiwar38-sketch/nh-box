<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_nh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Loading spinner shown while buffering -->
    <ProgressBar
        android:id="@+id/progress_buffering_nh"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_gesture_indicator_nh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/nh_bg_gesture_hint"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Rotate screen hint shown when the device is on portrait but the video would look better landscape -->
    <LinearLayout
        android:id="@+id/layout_rotate_hint_nh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/nh_bg_gesture_hint"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/btn_rotate_nh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/nh_ic_rotate"
            android:contentDescription="Rotate screen"
            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Rotate"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_lock_nh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="12dp"
        android:background="@drawable/nh_bg_ctrl_btn"
        android:src="@drawable/nh_ic_lock_open"
        android:contentDescription="Lock screen"
        android:elevation="10dp" />

    <!-- Centered unlock overlay: shown when screen is locked and user taps/swipes -->
    <LinearLayout
        android:id="@+id/unlock_hint_overlay_nh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/nh_bg_gesture_hint"
        android:paddingHorizontal="28dp"
        android:paddingVertical="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_unlock_icon_nh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/nh_ic_lock_closed"
            android:contentDescription="Unlock"
            android:alpha="1.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap to unlock"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls_container_nh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/nh_bg_player_overlay">

        <LinearLayout
            android:id="@+id/controls_top_nh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btn_back_player_nh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tv_player_title_nh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_rotate_top_nh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_rotate"
                android:contentDescription="Rotate screen"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btn_pip_nh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_pip"
                android:contentDescription="Picture in picture"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btn_aspect_nh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_aspect_ratio"
                android:contentDescription="Aspect ratio"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btn_audio_track_nh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_audio_track"
                android:contentDescription="Audio track" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_prev_nh"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_skip_previous"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/btn_play_pause_nh"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/nh_bg_play_btn"
                android:src="@drawable/nh_ic_play"
                android:contentDescription="Play/Pause"
                android:layout_marginHorizontal="24dp" />

            <ImageButton
                android:id="@+id/btn_next_nh"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/nh_bg_ctrl_btn"
                android:src="@drawable/nh_ic_skip_next"
                android:contentDescription="Next" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls_bottom_nh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_time_nh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_speed_nh"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/nh_bg_ctrl_btn"
                    android:paddingHorizontal="8dp"
                    android:src="@drawable/nh_ic_speed"
                    android:contentDescription="Speed" />

                <TextView
                    android:id="@+id/tv_total_time_nh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="0:00"
                    android:textColor="#999999"
                    android:textSize="12sp" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_progress_nh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- VIP preview countdown badge (only shown during the 2-minute free preview) -->
    <TextView
        android:id="@+id/tv_preview_badge_nh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/nh_bg_gesture_hint"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="VIP Preview"
        android:textColor="@color/accent_light"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="10dp" />

</FrameLayout>
