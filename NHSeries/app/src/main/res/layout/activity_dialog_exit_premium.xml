<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- Floating Card -->
    <LinearLayout
        android:id="@+id/exit_card"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@drawable/bg_exit_dialog_card"
        android:elevation="24dp">

        <!-- Glow Icon Container -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp">

            <!-- Glow ring -->
            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_exit_icon_glow" />

            <!-- Icon circle -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_exit_icon_circle">

                <!-- Power icon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⏻"
                    android:textSize="26sp"
                    android:textColor="#FF1A38" />
            </FrameLayout>
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/exit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit N𓆙G Series?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your session will be closed.\nSee you soon! 👋"
            android:textSize="13sp"
            android:textColor="#99FFFFFF"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="28dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_divider_gradient"
            android:layout_marginBottom="20dp" />

        <!-- Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <!-- Cancel Button -->
            <TextView
                android:id="@+id/btn_cancel_exit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Stay"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#CCFFFFFF"
                android:background="@drawable/bg_btn_stay"
                android:layout_marginEnd="8dp"
                android:letterSpacing="0.08" />

            <!-- Exit Button -->
            <TextView
                android:id="@+id/btn_confirm_exit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Exit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_exit_confirm"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
